{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "renderer/**/*",
    "common/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "common/*": ["./common/*"],
      "renderer/*": ["./renderer/*"]
    }
  }
}
